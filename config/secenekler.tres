[resource]
script = ExtResource("1_verisi")
kod_iste = true
kod_basligi = "Katılımcı Kodu"
kod_aciklamasi = "Size verilen kodu yazın ve Tamam'a basın."
yonerge_goster = true
yonerge = "[b]Nasıl Çalışır?[/b]

Birazdan topun hareketini izleyeceksiniz. Top zemine değdiği anda simülasyon duracak ve karşınıza bir soru çıkacak.

•  Seçeneklerden birini işaretleyerek topun hareketini ve kuvvet oklarını gözlemleyin.
•  Simülasyonu durdurabilir, yavaşlatabilir veya [b]Sıfırla[/b] butonuna basarak diğer seçenekleri tekrar deneyebilirsiniz.
•  Karar verirken ve sonuçları izlerken düşüncelerinizi sesli olarak ifade edin.

Katkılarınız için teşekkür ederiz. [b]Devam Et[/b] butonuna tıklayarak başlayabilirsiniz."
devam_dugmesi = "Devam Et"
secim_basligi = "Top az önce yere düşerek zeminle temas etti. Bundan sonra topa hangi kuvvetler uygulanacaktır?"
secim_ipucu = ""
secim_ipucu_referanssiz = ""
bitis_ipucu = "Sıfırla butonuyla diğer seçenekleri de deneyebilirsiniz."
soru_basligi = "Soru"
soru_metin_girisi = false
secenekler = Array[ExtResource("2_secenek")]([SubResource("Resource_a"), SubResource("Resource_b"), SubResource("Resource_c"), SubResource("Resource_d")])
